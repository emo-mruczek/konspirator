// B / C, result in A, remainder in B
// https://blog.segger.com/algorithms-for-division-part-2-classics/
// A <-> q
// B <-> u
// C <-> v
// D <-> u, then v
// E <-> u
// F <-> k

// check for divisor == 0
    SWP C
    JPOS div_one
    RST A
    RST B
    JUMP finish
// check for divisor == 1
div_one:
    DEC A
    JPOS copy_stuff
    SWP C
    SWP B
    RST B
    JUMP finish
// copy B to D
copy_stuff:
    INC A
    SWP C
    RST A
    ADD B
    SWP D
    RST A
    ADD C
    SWP E
    RST A
// start out by shifting C so that it's at least larger than B
    RST F
    SWP B
start:
    SUB C
    JPOS try_again
    ADD D
    SWP C
    SUB C
    JZERO dont_try_again
    ADD D
    SWP C
    JUMP try_again
dont_try_again:
    ADD E
    SWP C
    // INC F
    SHR C
    ADD D
    SWP B
    JUMP actual_actual_start
try_again:
    RST A
    ADD D
    SHL C
    INC F
    JUMP start
actual_actual_start:
    SWP F
actual_start:
    SWP F
    SWP B
    SUB C
    SHL B // real A
    JPOS not_negative
    ADD E
    SWP C
    SUB C
    JPOS negative
    ADD D
    SWP B
    JUMP not_negative
negative:
    ADD C
    SWP C
    JUMP shr_c
not_negative:
    SWP E
    SUB C
    INC B
shr_c:
    SWP B
    SHR C
    SHR D // copy of C
    DEC F
    SWP F
    JPOS actual_start
    SWP F
finish:
// done

according to the original C source code, before the loop u is larger than v

u - v >= 0
u >= v
0 >= v - u
v - u <= 0
!(v - u > 0)
