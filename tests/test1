PROGRAM IS
    a,
    b,
    c[2:10]
IN

    #WRITE 0;
    #WRITE 1;
    #WRITE 2;
    #WRITE 3;
    #WRITE 4;
    #WRITE 5;
    #WRITE 6;

    a := 4;
    b := a;
    #WRITE b;


    #c[2] := 3;
    c[4] := 5;
    #WRITE c[2];
    WRITE c[b];

    c[5] := 2 + 1; # 3
    c[6] := c[5] + 4; # 7
    c[7] := c[5] + c[6]; # 10
    WRITE c[5];
    WRITE c[6];
    WRITE c[7];


END

